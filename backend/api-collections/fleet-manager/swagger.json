  "info": {
    "title": "Fleet Manager API",
    "description": "API documentation",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Fleet Manager",
      "description": ""
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "schemas": {
      "DroneModel": {
        "type": "string",
        "description": "Serial number of the drone (exactly 13 characters long)",
        "enum": [
          "PHANTOM_4",
          "MATRICE_300",
          "MAVIC_3_ENTERPRISE"
        ]
      },
      "DroneStatus": {
        "type": "string",
        "description": "Status of the drone",
        "enum": [
          "AVAILABLE",
          "IN_MISSION",
          "MAINTENANCE",
          "RETIRED"
        ]
      },
      "CreateDroneRequestDto": {
        "type": "object",
        "properties": {
          "serialNumber": {
            "type": "string",
            "description": "Serial number of the drone (exactly 13 characters long)",
            "example": "SKY-1234-5678"
          },
          "model": {
            "type": "string",
            "description": "Model of the drone",
            "enum": [
              "PHANTOM_4",
              "MATRICE_300",
              "MAVIC_3_ENTERPRISE"
            ],
            "example": "MATRICE_300"
          }
        },
        "required": [
          "serialNumber",
          "model"
        ]
      },
      "UpdateDroneRequestDto": {
        "type": "object",
        "properties": {
          "model": {
            "example": "SKY-1234-5678",
            "$ref": "#/components/schemas/DroneModel"
          },
          "status": {
            "example": "AVAILABLE",
            "$ref": "#/components/schemas/DroneStatus"
          }
        },
        "required": [
          "status"
        ]
      },
      "MissionType": {
        "type": "string",
        "description": "Type of the mission",
        "enum": [
          "WIND_TURBINE_INSPECTION",
          "SOLAR_PANEL_SURVEY",
          "POWER_LINE_PATROL"
        ]
      },
      "MissionStatus": {
        "type": "string",
        "description": "Status of the mission",
        "enum": [
          "PLANNED",
          "PRE_FLIGHT_CHECK",
          "IN_PROGRESS",
          "COMPLETED",
          "ABORTED"
        ]
      },
      "CreateMissionRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the mission",
            "maxLength": 255,
            "example": "Alpha Perimeter Inspection"
          },
          "type": {
            "type": "string",
            "description": "Type of the mission",
            "enum": [
              "WIND_TURBINE_INSPECTION",
              "SOLAR_PANEL_SURVEY",
              "POWER_LINE_PATROL"
            ],
            "example": "POWER_LINE_PATROL"
          },
          "droneId": {
            "type": "string",
            "description": "UUID of the assigned drone",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "pilotName": {
            "type": "string",
            "description": "Name of the assigned pilot",
            "maxLength": 255,
            "example": "John Doe"
          },
          "siteLocation": {
            "type": "string",
            "description": "Location or site of the mission",
            "maxLength": 255,
            "example": "Site Alpha - Sector 4"
          },
          "scheduledStartTime": {
            "type": "string",
            "description": "Scheduled start time of the mission (ISO 8601)",
            "example": "2026-08-01T08:00:00Z"
          },
          "scheduledEndTime": {
            "type": "string",
            "description": "Scheduled end time of the mission (ISO 8601)",
            "example": "2026-08-01T12:00:00Z"
          }
        },
        "required": [
          "name",
          "type",
          "droneId",
          "pilotName",
          "siteLocation",
          "scheduledStartTime",
          "scheduledEndTime"
        ]
      },
      "UpdateMissionRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the mission",
            "maxLength": 255,
            "example": "Alpha Perimeter Inspection"
          },
          "type": {
            "example": "POWER_LINE_PATROL",
            "$ref": "#/components/schemas/MissionType"
          },
          "droneId": {
            "type": "string",
            "description": "UUID of the assigned drone",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "pilotName": {
            "type": "string",
            "description": "Name of the assigned pilot",
            "maxLength": 255,
            "example": "John Doe"
          },
          "siteLocation": {
            "type": "string",
            "description": "Location or site of the mission",
            "maxLength": 255,
            "example": "Site Alpha - Sector 4"
          },
          "scheduledStartTime": {
            "type": "string",
            "description": "Scheduled start time of the mission (ISO 8601)",
            "example": "2026-08-01T08:00:00Z"
          },
          "scheduledEndTime": {
            "type": "string",
            "description": "Scheduled end time of the mission (ISO 8601)",
            "example": "2026-08-01T12:00:00Z"
          },
          "status": {
            "example": "IN_PROGRESS",
            "$ref": "#/components/schemas/MissionStatus"
          }
        }
      },
      "MaintenanceType": {
        "type": "string",
        "description": "Type of maintenance performed",
        "enum": [
          "ROUTINE_CHECK",
          "BATTERY_REPLACEMENT",
          "MOTOR_REPAIR",
          "FIRMWARE_UPDATE",
          "FULL_OVERHAUL"
        ]
      },
      "CreateMaintenanceLogRequestDto": {
        "type": "object",
        "properties": {
          "droneId": {
            "type": "string",
            "description": "ID of the drone being maintained",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "type": {
            "type": "string",
            "description": "Type of maintenance performed",
            "enum": [
              "ROUTINE_CHECK",
              "BATTERY_REPLACEMENT",
              "MOTOR_REPAIR",
              "FIRMWARE_UPDATE",
              "FULL_OVERHAUL"
            ],
            "example": "ROUTINE_CHECK"
          },
          "technicianName": {
            "type": "string",
            "description": "Name of the technician performing maintenance",
            "example": "John Doe"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes or remarks",
            "example": "Replaced left rotor and updated firmware."
          },
          "performedAt": {
            "type": "string",
            "description": "Timestamp when maintenance was performed",
            "example": "2026-07-26T10:00:00.000Z"
          },
          "flightHoursAtMaintenance": {
            "type": "number",
            "description": "Drone flight hours at the time of maintenance",
            "example": 45.5
          }
        },
        "required": [
          "droneId",
          "type",
          "technicianName",
          "performedAt",
          "flightHoursAtMaintenance"
        ]
      },
      "UpdateMaintenanceLogRequestDto": {
        "type": "object",
        "properties": {
          "droneId": {
            "type": "string",
            "description": "ID of the drone being maintained",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "type": {
            "example": "ROUTINE_CHECK",
            "$ref": "#/components/schemas/MaintenanceType"
          },
          "technicianName": {
            "type": "string",
            "description": "Name of the technician performing maintenance",
            "example": "John Doe"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes or remarks",
            "example": "Replaced left rotor and updated firmware."
          },
          "performedAt": {
            "type": "string",
            "description": "Timestamp when maintenance was performed",
            "example": "2026-07-26T10:00:00.000Z"
          },
          "flightHoursAtMaintenance": {
            "type": "number",
            "description": "Drone flight hours at the time of maintenance",
            "example": 45.5
          }
        }
      }
    }
  }
}